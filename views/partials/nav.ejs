<a class="skip" href="#content">Skip to content</a>
<% const activePage = typeof page === 'string' ? page : ''; %>
<header class="topbar">
  <nav aria-label="Main navigation">
    <div class="brand-group">
      <a href="/" class="brand"><img src="/lablink.svg" alt="" width="32" height="32"> LabLink</a>
      <% if (currentUser) { %><span class="role-label"><%= currentUser.role === 'faculty' ? 'Faculty mode' : 'Student mode' %></span><% } %>
    </div>
    <% if (currentUser) { %>
      <a href="/catalog"<% if (activePage === 'catalog') { %> aria-current="page"<% } %>>Catalog</a>
      <% if (currentUser.role === 'student') { %><a href="/requests"<% if (activePage === 'requests') { %> aria-current="page"<% } %>>My requests</a><% } %>
      <% if (currentUser.role === 'faculty') { %><a href="/faculty"<% if (activePage === 'faculty') { %> aria-current="page"<% } %>>Booking Requests</a><% } %>
      <a href="/account"<% if (activePage === 'account') { %> aria-current="page"<% } %>>Account</a>
      <% if (demoMode) { %><a href="/sign-in">Switch role</a><% } %>
    <% } else { %>
      <a href="/sign-in"><%= demoMode ? 'Try the demo' : 'Sign in' %></a>
    <% } %>
  </nav>
</header>
