<header class="topbar">
  <nav aria-label="Main navigation">
    <a href="/" class="brand"><span aria-hidden="true">L</span> LabLink</a>
    <% if (currentUser) { %>
      <a href="/catalog">Catalog</a>
      <% if (currentUser.role === 'student') { %><a href="/requests">My requests</a><% } %>
