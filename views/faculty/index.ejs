<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Booking Requests · LabLink</title>
    <link rel="icon" href="/lablink.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
    <script src="/ai-status.js" defer></script>
  </head>
  <body>
    <%- include('../partials/nav', { page: 'faculty' }) %>
    <main id="content" class="flow">
      <h1>Booking Requests</h1>
      <p class="muted">Compare requests for the same slot before approving a booking.</p>
      <% if (error) { %><p role="alert"><%= error %></p><% } %>
      <% if (!slotGroups.length) { %><p>No pending requests.</p><% } %>
      <% for (const { requests, recommendation, aiExplanation } of slotGroups) { %>
        <% const slot = requests[0]; %>
        <section class="queue-item" aria-labelledby="slot-<%= slot.slot_id %>">
          <header>
            <h2 id="slot-<%= slot.slot_id %>"><%= slot.resource_name %></h2>
            <p class="muted"><%= slot.department %> · <%= formatTime(slot.starts_at) %> to <%= formatTime(slot.ends_at) %></p>
          </header>
          <% if (recommendation) { %>
            <div class="recommendation">
            <p><strong>Recommended: <%= recommendation.winner.student_name %></strong></p>
            <p><strong>Rule-based explanation:</strong> <%= recommendation.reason %></p>
            <p>The recommendation does not reserve the slot; faculty make the final decision.</p>
            <form method="post" action="/faculty/slots/<%= slot.slot_id %>/explain" class="actions" data-ai>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="tonal">Explain with Gemini</button>
              <span role="status" data-wait></span>
            </form>
            <% if (aiExplanation?.ok) { %>
              <p role="status"><strong>Gemini explanation:</strong> <%= aiExplanation.text %></p>
            <% } else if (aiExplanation) { %>
              <p role="status"><%= aiExplanation.reason === 'not_configured' ? 'Gemini is not configured.' : 'Gemini could not generate an explanation.' %> Use the rule-based explanation above.</p>
            <% } %>
            </div>
          <% } %>
          <div class="grid">
          <% for (const request of requests) { %>
             <article class="surface candidate">
               <h3><%= request.student_name %> · Request #<%= request.id %></h3>
              <% if (recommendation?.winner.id === request.id) { %><p><span class="badge">Recommended</span></p><% } %>
              <div class="comparison-facts">
                <p><strong>Deadline:</strong> <%= formatTime(request.deadline) %></p>
                <% if (recommendation?.counts.has(request.id)) { %>
                  <p><strong>Viable alternatives before deadline:</strong> <%= recommendation.counts.get(request.id) %></p>
                <% } %>
              </div>
               <p><strong>Project:</strong> <%= request.project_details %></p>
              <% if (request.requirements) { %><p><strong>Requirements:</strong> <%= request.requirements %></p><% } %>
              <form method="post" action="/faculty/requests/<%= request.id %>/approve" class="actions decision-actions">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (request.booked_request_id === null && request.starts_at > now && request.ends_at <= request.deadline) { %>
                  <button type="submit" aria-label="Approve request <%= request.id %> from <%= request.student_name %>">Approve</button>
                <% } else { %>
                  <p>This slot can no longer be approved.</p>
                <% } %>
                <button class="outline" type="submit" formaction="/faculty/requests/<%= request.id %>/decline" aria-label="Decline request <%= request.id %> from <%= request.student_name %>">Decline</button>
              </form>
            </article>
          <% } %>
          </div>
        </section>
      <% } %>
    </main>
  </body>
</html>
