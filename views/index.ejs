<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LabLink</title>
  </head>
  <body>
    <main>
      <h1>LabLink</h1>
      <p>Campus laboratory resource sharing.</p>
      <% if (currentUser) { %>
        <p><a href="/catalog">Browse the equipment catalog</a></p>
        <% if (currentUser.role === 'student') { %><p><a href="/requests">My requests</a></p><% } %>
        <% if (currentUser.role === 'faculty') { %><p><a href="/faculty">Review booking requests</a></p><% } %>
        <p><a href="/account">View your demo account</a></p>
      <% } else { %>
        <p><a href="/sign-in">Sign in to the demo</a></p>
      <% } %>
    </main>
  </body>
</html>
