<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LabLink</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <%- include('partials/nav') %>
    <main id="content">
      <section class="hero">
      <p class="eyebrow">LabLink · Campus laboratories</p>
      <h1>LabLink</h1>
      <p class="lead">Find the equipment your project needs.</p>
      <p>Explore instruments across departments, request lab time, and get a fair recommendation when slots overlap.</p>
      <% if (currentUser) { %>
        <p><a class="button" href="/catalog">Browse the equipment catalog</a></p>
        <% if (currentUser.role === 'student') { %><p><a href="/requests">My requests</a></p><% } %>
        <% if (currentUser.role === 'faculty') { %><p><a href="/faculty">Review booking requests</a></p><% } %>
        <p><a href="/account">View your demo account</a></p>
      <% } else { %>
        <p><a class="button" href="/sign-in"><%= demoMode ? 'Choose a demo role' : 'Sign in with college ID' %></a></p>
      <% } %>
      </section>
    </main>
  </body>
</html>
