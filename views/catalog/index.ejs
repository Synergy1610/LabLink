<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Equipment catalog · LabLink</title>
    <link rel="icon" href="/lablink.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
    <script src="/ai-status.js" defer></script>
    <script src="/catalog-dialogs.js" defer></script>
    <script src="/slot-dialog.js" defer></script>
  </head>
  <body>
    <%- include('../partials/nav', { page: 'catalog' }) %>
    <main id="content" class="flow">
      <header class="catalog-heading">
        <div>
          <h1>Equipment catalog</h1>
          <p class="muted"><%= resources.length %> <%= resources.length === 1 ? 'item' : 'items' %><% if (demoMode && resources.length) { %> · Representative photos<% } %></p>
        </div>
        <div class="actions catalog-toolbar">
          <button type="button" class="tonal" data-open-catalog="catalog-filters" aria-haspopup="dialog" hidden>Use filters</button>
          <% if (currentUser.role === 'student') { %>
            <button type="button" class="outline" data-open-catalog="catalog-ai" aria-haspopup="dialog" hidden>Find with AI</button>
          <% } %>
        </div>
      </header>
      <% if (search || lab) { %>
        <div class="actions catalog-filters-active">
          <span class="muted">Filters: <%= [search && `“${search}”`, lab].filter(Boolean).join(' · ') %></span>
          <a href="/catalog" class="button outline">Clear filters</a>
        </div>
      <% } %>
      <section class="surface" data-catalog-panel="catalog-filters" aria-labelledby="filters-heading">
        <h2 id="filters-heading">Filter equipment</h2>
        <form action="/catalog" method="get" role="search" class="stack">
          <div>
            <label for="search">Search equipment</label>
            <input id="search" name="q" type="search" maxlength="100" value="<%= search %>" placeholder="Name, category, or department">
          </div>
          <div>
            <label for="lab">Lab</label>
            <select id="lab" name="lab">
              <option value="">All labs</option>
              <% for (const name of labs) { %><option value="<%= name %>"<% if (name === lab) { %> selected<% } %>><%= name %></option><% } %>
            </select>
          </div>
          <button type="submit">Apply filters</button>
        </form>
      </section>
      <% if (currentUser.role === 'student') { %>
        <section class="surface catalog-assist" data-catalog-panel="catalog-ai"<% if (message || matches !== null) { %> data-show-on-load<% } %> aria-labelledby="gemini-heading">
          <h2 id="gemini-heading">Find equipment with Gemini</h2>
          <p class="muted">Describe what you’re building to get suggestions from the lab catalog.</p>
          <form action="/catalog/match" method="post" class="stack" data-ai>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="q" value="<%= search %>">
            <input type="hidden" name="lab" value="<%= lab %>">
            <label for="project">Project description</label>
            <textarea id="project" name="project" rows="4" required maxlength="<%= projectDescriptionLimit %>" aria-describedby="project-privacy"><%= project %></textarea>
            <p class="muted field-hint" id="project-privacy">Your description is sent to Gemini. Don’t include personal or confidential information.</p>
            <button type="submit">Get AI suggestions</button>
            <span role="status" data-wait></span>
          </form>
          <% if (message) { %><p role="status"><%= message %></p><% } %>
          <% if (matches !== null) { %>
            <h3>Gemini suggestions</h3>
            <% if (matches.length) { %>
              <ul class="match-list">
                <% for (const match of matches) { %>
                  <li><div><strong><%= match.name %></strong><p><%= match.reason %></p></div>
                    <a class="button outline" href="<%= resources.some((resource) => resource.id === match.resourceId) ? '' : '/catalog' %>#resource-<%= match.resourceId %>" aria-label="View equipment: <%= match.name %>">View equipment</a></li>
                <% } %>
              </ul>
              <p>Check the catalog below for actual availability. Faculty approval is still required.</p>
            <% } else { %><p>No suitable equipment was suggested. Try another description or search manually.</p><% } %>
          <% } %>
        </section>
      <% } %>
      <% if (!resources.length) { %><p class="surface">No equipment matches these filters. Try a different search or clear your filters.</p><% } %>
      <% for (const [index, group] of labGroups.entries()) { %>
        <section class="catalog-lab" aria-labelledby="catalog-lab-<%= index %>">
          <h2 id="catalog-lab-<%= index %>"><%= group.name %></h2>
          <div class="grid catalog-grid">
            <% for (const resource of group.resources) { %>
              <article class="resource catalog-card" id="resource-<%= resource.id %>" tabindex="-1">
                <% if (demoMode && photoFor(resource.id)) { %>
                  <img src="<%= photoFor(resource.id).src %>" alt="<%= photoFor(resource.id).alt %>" loading="lazy" width="500" height="281">
                <% } %>
                <h3><%= resource.name %></h3>
                <div class="catalog-availability">
                  <% if (resource.slots.length) { %>
                    <p><%= resource.slots.length %> available <%= resource.slots.length === 1 ? 'slot' : 'slots' %></p>
                    <% if (currentUser.role === 'student') { %>
                      <a class="button tonal" data-slot-dialog href="/requests/choose?resource=<%= resource.id %>" aria-label="Choose a slot for <%= resource.name %>">Choose a slot</a>
                    <% } %>
                  <% } else { %><p class="muted">No available slots</p><% } %>
                </div>
                <details class="equipment-details">
                  <summary aria-label="Details for <%= resource.name %>">Details</summary>
                  <p><%= resource.category %> · <%= resource.department %></p>
                  <p><%= resource.description %></p>
                  <p><strong>Capabilities:</strong> <%= resource.capabilities %></p>
                </details>
              </article>
            <% } %>
          </div>
        </section>
      <% } %>
      <% if (currentUser.role === 'student') { %>
        <dialog id="slot-dialog" aria-labelledby="slot-dialog-heading">
          <div class="dialog-heading">
            <h2 id="slot-dialog-heading">Choose a slot</h2>
            <button type="button" class="outline" data-close autofocus>Close</button>
          </div>
          <p class="muted" data-equipment></p>
          <p role="status" data-slot-status></p>
          <form class="stack" action="/requests" method="get" hidden>
            <label for="dialog-date">Date (DD/MM/YYYY)</label>
            <select id="dialog-date" required></select>
            <label for="dialog-time">Available time (IST)</label>
            <select id="dialog-time" name="slot" required disabled></select>
            <button type="submit" disabled>Continue to booking</button>
          </form>
        </dialog>
      <% } %>
    </main>
  </body>
</html>
