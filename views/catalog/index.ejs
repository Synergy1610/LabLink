<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Equipment catalog · LabLink</title>
    <link rel="icon" href="/lablink.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
    <script src="/ai-status.js" defer></script>
  </head>
  <body>
    <%- include('../partials/nav', { page: 'catalog' }) %>
    <main id="content" class="flow">
      <h1>Equipment catalog</h1>
      <p class="muted">Browse lab equipment, development kits, and workstations across campus.</p>
      <form action="/catalog" method="get" role="search" class="surface stack">
        <div class="filter-grid">
          <div><label for="search">Search equipment</label>
          <input id="search" name="q" type="search" maxlength="100" value="<%= search %>" placeholder="Name, category, or department"></div>
          <div><label for="lab">Lab</label>
          <select id="lab" name="lab">
            <option value="">All labs</option>
            <% for (const name of labs) { %><option value="<%= name %>"<% if (name === lab) { %> selected<% } %>><%= name %></option><% } %>
          </select></div>
        </div>
        <div class="actions">
          <button type="submit">Apply filters</button>
          <% if (search || lab) { %><a class="button outline" href="/catalog">Clear filters</a><% } %>
        </div>
      </form>
      <% if (currentUser.role === 'student') { %>
        <details class="surface catalog-assist"<% if (project || message || matches !== null) { %> open<% } %>>
          <summary>Find equipment with Gemini</summary>
          <form action="/catalog/match" method="post" class="stack" data-ai>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <p><label for="project">Project description</label></p>
            <p id="project-privacy">This optional feature sends your description to Gemini. Don’t include personal or confidential information.</p>
            <textarea id="project" name="project" rows="4" required maxlength="<%= projectDescriptionLimit %>" aria-describedby="project-privacy"><%= project %></textarea>
            <button type="submit">Get AI suggestions</button>
            <span role="status" data-wait></span>
          </form>
          <% if (message) { %><p role="status"><%= message %></p><% } %>
          <% if (matches !== null) { %>
            <h3>Gemini suggestions</h3>
            <% if (matches.length) { %>
              <ul>
                <% for (const match of matches) { %>
                  <li><a class="button outline" href="#resource-<%= match.resourceId %>"><%= match.name %></a> — <%= match.reason %></li>
                <% } %>
              </ul>
              <p>Check the catalog below for actual availability. Faculty approval is still required.</p>
            <% } else { %><p>No suitable equipment was suggested. Try another description or search manually.</p><% } %>
          <% } %>
        </details>
      <% } %>
      <% if (!resources.length) { %><p>No matching resources.</p><% } %>
      <div class="grid">
      <% for (const resource of resources) { %>
        <article class="resource" id="resource-<%= resource.id %>">
          <% if (demoMode && photoFor(resource.id)) { %>
            <img src="<%= photoFor(resource.id).src %>" alt="<%= photoFor(resource.id).alt %>" loading="lazy" width="500" height="281">
            <small>Representative photo</small>
          <% } %>
          <h2><%= resource.name %></h2>
          <p class="muted"><%= resource.lab %> · <%= resource.category %></p>
          <p><%= resource.description %></p>
          <p><strong>Capabilities:</strong> <%= resource.capabilities %></p>
          <% if (resource.slots.length) { %>
            <p><%= resource.slots.length %> available <%= resource.slots.length === 1 ? 'slot' : 'slots' %></p>
            <% if (currentUser.role === 'student') { %>
              <a class="button tonal" href="/requests/choose?resource=<%= resource.id %>" aria-label="Choose a slot for <%= resource.name %>">Choose a slot</a>
            <% } %>
          <% } else { %><p>No available slots.</p><% } %>
        </article>
      <% } %>
      </div>
    </main>
  </body>
</html>
