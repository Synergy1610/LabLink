{
  "name": "lablink",
  "version": "0.1.0",
  "description": "Campus lab equipment booking prototype for students and faculty",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node --env-file-if-exists=.env src/server.js --demo",
    "review": "node --env-file-if-exists=.env src/server.js --review",
    "provision": "node src/auth/provision.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "test": "node --test"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
